{
  "name": "scopearr-web",
  "private": true,
  "version": "2.0.1",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "check:e2e": "tsc --noEmit -p e2e/tsconfig.json",
    "test": "node --test test/*.test.mjs",
    "e2e": "playwright test --project=invariants",
    "e2e:dialogs": "playwright test --project=dialogs",
    "e2e:pixel": "playwright test --project=pixel",
    "e2e:pixel:update": "playwright test --project=pixel --update-snapshots"
  },
  "dependencies": {
    "lucide-preact": "1.53.0",
    "preact": "10.29.6"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "24.19.2",
    "axe-core": "4.14.0",
    "prettier": "^3.9.9",
    "typescript": "5.9.3",
    "vite": "8.3.8"
  }
}
